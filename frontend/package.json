{
  "name": "yoga-studio-frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e:open": "cypress open",
    "e2e:run": "cypress run",
    "pree2e:run": "node scripts/reset-e2e-coverage.cjs",
    "e2e:coverage:check": "node scripts/check-e2e-coverage.cjs",
    "dev:e2e": "cross-env VITE_COVERAGE=true VITE_API_TARGET=http://localhost:8081 vite --strictPort",
    "preview": "vite preview",
    "test:typecheck": "tsc -p tsconfig.test.json",
    "e2e:typecheck": "tsc -p cypress/tsconfig.json",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:ratio": "node ../scripts/check-integration-ratio.cjs frontend"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "axios": "^1.13.4",
    "react": "^19.2.2",
    "react-dom": "^19.2.2",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@cypress/code-coverage": "^4.0.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.11",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/coverage-v8": "^4.1.11",
    "cross-env": "^10.1.0",
    "cypress": "^16.1.1",
    "jsdom": "^29.1.1",
    "nyc": "^18.0.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-istanbul": "^9.0.1",
    "vitest": "^4.1.11"
  }
}
