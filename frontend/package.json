{
  "name": "yoga-studio-frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e:open": "cypress open",
    "e2e:run": "cypress run",
    "e2e:coverage:check": "nyc check-coverage",
    "dev:e2e": "cross-env VITE_COVERAGE=true vite --strictPort",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "axios": "^1.13.4",
    "react": "^19.2.2",
    "react-dom": "^19.2.2",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@cypress/code-coverage": "^4.0.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.11",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/coverage-v8": "^4.1.11",
    "cross-env": "^10.1.0",
    "cypress": "^16.1.1",
    "jsdom": "^29.1.1",
    "nyc": "^18.0.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-istanbul": "^9.0.1",
    "vitest": "^4.1.11"
  }
